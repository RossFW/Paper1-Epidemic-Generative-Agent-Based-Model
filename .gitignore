# Pickled simulation checkpoints — regenerable intermediate state, not
# human-readable, version-fragile. The usable data is in the CSV exports.
# (~859 MB across 44 files.) Available on request / by re-running the sims.
*.pkl

# Python
__pycache__/
*.py[cod]
*.pyo

# Secrets
.env

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Notebook checkpoints
.ipynb_checkpoints/

# R session artifacts + runtime logs
.RData
.Rhistory
*.log
errors.txt
backoff_log.txt

# Per-run simulation re-exports (regenerated by extract_pkl.py from the pkls).
# The Full Feedback R03 runs these duplicate live in Data Raw/Full Feedback/R03/.
responses_over_time_run_*.csv
stats_for_agents_run_*.csv
