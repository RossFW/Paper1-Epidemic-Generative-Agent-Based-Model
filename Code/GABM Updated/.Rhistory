# ──────────────────────────────────────────────────────────────────────────────
library(data.table)
library(dplyr)
library(fixest)
library(lme4)
library(broom)
library(broom.mixed)
library(purrr)
library(glmmTMB)
# ──────────────────────────────────────────────────────────────────────────────
# 1.  Load & prep data (scale CF, build poly on CF_z)
# ──────────────────────────────────────────────────────────────────────────────
df <- fread("Run1_Indiv_Data_for_logistic_regression.csv") %>%
mutate(agent_key = paste0(`Run Number`, "_", name),
id        = as.integer(factor(agent_key))) %>%
rename(time                = `Time Step`,
StayHome            = Response,
SlightCough         = slight_cough,
FeverCough          = cough_and_fever,
CF_orig             = `Daily New Cases Day 4`,
extraversion        = Extraversion,
agreeableness       = Agreeableness,
conscientiousness   = Conscientiousness,
emotional_stability = `Emotional Stability`,
intellect           = `Openness to Experience`) %>%
mutate(
CF_z  = as.numeric(scale(CF_orig)),
age_z = as.numeric(scale(age))
)
# build a single orthogonal basis for CF_z
polyCF <- poly(df$CF_z, 2)    # 2 columns: linear, quadratic, uncorrelated
df <- df %>%
mutate(
CF1 = polyCF[,1],         # linear
CF2 = polyCF[,2]          # quadratic
)
# ──────────────────────────────────────────────────────────────────────────────
# 2.  Fit the four models
# ──────────────────────────────────────────────────────────────────────────────
FE1 <- feglm(StayHome ~ SlightCough + FeverCough       | id, df, family="logit")
FE2 <- feglm(StayHome ~ SlightCough + FeverCough + CF1 | id, df, family="logit")
FE3 <- feglm(StayHome ~ SlightCough + FeverCough + CF1 + CF2 | id, df, family="logit")
RE4 <- glmer(
StayHome ~ SlightCough + FeverCough + CF1 + CF2 +
agreeableness + conscientiousness +
extraversion  + emotional_stability +
intellect     + age_z + gender +
(1|id),
df, family=binomial,
control = glmmTMBControl(
optimizer = optim,
optArgs   = list(iter.max = 1e6, eval.max = 1e6)
)
)
# ──────────────────────────────────────────────────────────────────────────────
# 0.  Packages
# ──────────────────────────────────────────────────────────────────────────────
library(data.table)    # fread
library(dplyr)         # data wrangling
library(fixest)        # feglm
library(lme4)          # glmer
library(broom)         # tidy.fixest
library(broom.mixed)   # tidy.glmerMod
library(purrr)         # map_df
# ──────────────────────────────────────────────────────────────────────────────
# 1.  Load & prep data with unit-variance scaling
# ──────────────────────────────────────────────────────────────────────────────
df <- fread("Run1_Indiv_Data_for_logistic_regression.csv") %>%
mutate(agent_key = paste0(`Run Number`, "_", name),
id        = as.integer(factor(agent_key))) %>%
rename(time                = `Time Step`,
StayHome            = Response,
SlightCough         = slight_cough,
FeverCough          = cough_and_fever,
CaseFeedback_orig   = `Daily New Cases Day 4`,
extraversion        = Extraversion,
agreeableness       = Agreeableness,
conscientiousness   = Conscientiousness,
emotional_stability = `Emotional Stability`,
intellect           = `Openness to Experience`) %>%
# scale up raw counts
mutate(CaseFeedback_raw = CaseFeedback_orig * 1000) %>%
# center & scale to unit variance
mutate(
CF_z  = as.numeric(scale(CaseFeedback_raw)),
CF2_z = CF_z^2,
age_z = as.numeric(scale(age))
)
# ──────────────────────────────────────────────────────────────────────────────
# 2.  Fit the four models
# ──────────────────────────────────────────────────────────────────────────────
FE1 <- feglm(StayHome ~ SlightCough + FeverCough             | id,
df, family = "logit")
FE2 <- feglm(StayHome ~ SlightCough + FeverCough + CF_z     | id,
df, family = "logit")
FE3 <- feglm(StayHome ~ SlightCough + FeverCough +
CF_z + CF2_z                    | id,
df, family = "logit")
RE4 <- glmer(StayHome ~ SlightCough + FeverCough +
CF_z + CF2_z +
agreeableness + conscientiousness +
extraversion + emotional_stability +
intellect + age_z + gender +
(1 | id),
df, family = binomial,
control = glmerControl(
optimizer = "bobyqa",
optCtrl   = list(maxfun = 1e6)
))
models <- list(FE1 = FE1, FE2 = FE2, FE3 = FE3, RE4 = RE4)
# ──────────────────────────────────────────────────────────────────────────────
# 3.  Pull out coefficient tables
# ──────────────────────────────────────────────────────────────────────────────
coef_table <- map_df(names(models), function(nm) {
m <- models[[nm]]
t <- if (inherits(m, "fixest")) {
broom::tidy(m)
} else {
broom.mixed::tidy(m, effects = "fixed")
}
t %>%
select(term, estimate, std.error, statistic, p.value) %>%
mutate(model = nm)
}, .id = NULL)
# ──────────────────────────────────────────────────────────────────────────────
# 4.  Pull out model-level stats: N, BIC, pseudo-R² (FE only)
# ──────────────────────────────────────────────────────────────────────────────
get_pR2 <- function(m) {
if (inherits(m, "fixest")) {
as.numeric(r2(m, type = "pr2"))   # McFadden R²
} else {
NA_real_
}
}
model_stats <- map_df(names(models), function(nm) {
m <- models[[nm]]
data.frame(
model    = nm,
N        = nobs(m),
BIC      = BIC(m),
PseudoR2 = get_pR2(m),
stringsAsFactors = FALSE
)
}) %>%
distinct(model, .keep_all = TRUE) %>%
mutate(
N        = format(N, big.mark = ","),
BIC      = sprintf("%.1f", BIC),
PseudoR2 = ifelse(is.na(PseudoR2), "", sprintf("%.3f", PseudoR2))
) %>%
select(model, N, BIC, PseudoR2)
# ──────────────────────────────────────────────────────────────────────────────
# 5.  Inspect & save
# ──────────────────────────────────────────────────────────────────────────────
print(coef_table)
print(model_stats)
write.csv(coef_table,  "v4_model_coefficients.csv", row.names = FALSE)
write.csv(model_stats, "v4_model_gof_stats.csv",    row.names = FALSE)
# ──────────────────────────────────────────────────────────────────────────────
# 0.  Packages (install broom.mixed if you haven’t already)
# ──────────────────────────────────────────────────────────────────────────────
library(data.table)    # fread
library(dplyr)         # data wrangling
library(fixest)        # feglm
library(lme4)          # glmer
library(broom)         # tidy.fixest
library(broom.mixed)   # tidy.glmerMod
library(purrr)         # map_df
# ──────────────────────────────────────────────────────────────────────────────
# 1.  Load & prep data
# ──────────────────────────────────────────────────────────────────────────────
df <- fread("AllRuns_Indiv_Data_for_logistic_regression.csv") %>%
mutate(agent_key = paste0(`Run Number`, "_", name),
id        = as.integer(factor(agent_key))) %>%
rename(time                = `Time Step`,
StayHome            = Response,
SlightCough         = slight_cough,
FeverCough          = cough_and_fever,
CaseFeedback        = `Daily New Cases Day 4`,
extraversion        = Extraversion,
agreeableness       = Agreeableness,
conscientiousness   = Conscientiousness,
emotional_stability = `Emotional Stability`,
intellect           = `Openness to Experience`) %>%
mutate(CaseFeedback  = CaseFeedback * 1000,
CaseFeedback2 = CaseFeedback^2)
# ──────────────────────────────────────────────────────────────────────────────
# 2.  Fit the four models
# ──────────────────────────────────────────────────────────────────────────────
FE1 <- feglm(StayHome ~ SlightCough + FeverCough               | id,
df, family = "logit")
FE2 <- feglm(StayHome ~ SlightCough + FeverCough + CaseFeedback | id,
df, family = "logit")
FE3 <- feglm(StayHome ~ SlightCough + FeverCough +
CaseFeedback + CaseFeedback2          | id,
df, family = "logit")
RE4 <- glmer(StayHome ~ SlightCough + FeverCough +
CaseFeedback + CaseFeedback2 +
agreeableness + conscientiousness + extraversion +
emotional_stability + intellect +
age + gender + (1 | id),
df, family = binomial)
# ──────────────────────────────────────────────────────────────────────────────
# 0.  Packages (install broom.mixed if you haven’t already)
# ──────────────────────────────────────────────────────────────────────────────
library(data.table)    # fread
library(dplyr)         # data wrangling
library(fixest)        # feglm
library(lme4)          # glmer
library(broom)         # tidy.fixest
library(broom.mixed)   # tidy.glmerMod
library(purrr)         # map_df
# ──────────────────────────────────────────────────────────────────────────────
# 1.  Load & prep data
# ──────────────────────────────────────────────────────────────────────────────
df <- fread("Run1_Indiv_Data_for_logistic_regression.csv") %>%
mutate(agent_key = paste0(`Run Number`, "_", name),
id        = as.integer(factor(agent_key))) %>%
rename(time                = `Time Step`,
StayHome            = Response,
SlightCough         = slight_cough,
FeverCough          = cough_and_fever,
CaseFeedback        = `Daily New Cases Day 4`,
extraversion        = Extraversion,
agreeableness       = Agreeableness,
conscientiousness   = Conscientiousness,
emotional_stability = `Emotional Stability`,
intellect           = `Openness to Experience`) %>%
mutate(CaseFeedback  = CaseFeedback * 1000,
CaseFeedback2 = CaseFeedback^2)
# ──────────────────────────────────────────────────────────────────────────────
# 2.  Fit the four models
# ──────────────────────────────────────────────────────────────────────────────
FE1 <- feglm(StayHome ~ SlightCough + FeverCough               | id,
df, family = "logit")
FE2 <- feglm(StayHome ~ SlightCough + FeverCough + CaseFeedback | id,
df, family = "logit")
FE3 <- feglm(StayHome ~ SlightCough + FeverCough +
CaseFeedback + CaseFeedback2          | id,
df, family = "logit")
RE4 <- glmer(StayHome ~ SlightCough + FeverCough +
CaseFeedback + CaseFeedback2 +
agreeableness + conscientiousness + extraversion +
emotional_stability + intellect +
age + gender + (1 | id),
df, family = binomial)
models <- list(FE1 = FE1, FE2 = FE2, FE3 = FE3, RE4 = RE4)
# ──────────────────────────────────────────────────────────────────────────────
# 3.  Pull out coefficient tables (term, estimate, SE, z/t-stat, p-value)
# ──────────────────────────────────────────────────────────────────────────────
coef_table <- map_df(names(models), function(nm) {
m <- models[[nm]]
t <- if (inherits(m, "fixest")) {
broom::tidy(m)
} else {
broom.mixed::tidy(m, effects = "fixed")
}
t %>%
select(term, estimate, std.error, statistic, p.value) %>%
mutate(model = nm)
}, .id = NULL)
# ──────────────────────────────────────────────────────────────────────────────
# 4.  Pull out model-level stats: N, BIC, pseudo-R² (FE only)
# ──────────────────────────────────────────────────────────────────────────────
get_pR2 <- function(m) {
if (inherits(m, "fixest")) {
as.numeric(r2(m, type = "pr2"))  # McFadden R²
} else {
NA_real_
}
}
model_stats <- purrr::map_df(names(models), function(nm) {
m <- models[[nm]]
data.frame(
model    = nm,
N        = nobs(m),
BIC      = BIC(m),
PseudoR2 = get_pR2(m),
stringsAsFactors = FALSE
)
}) %>%
# Ensure one row per model in case of reruns
distinct(model, .keep_all = TRUE) %>%
# Format for readability
mutate(
N        = format(N, big.mark = ","),
BIC      = sprintf("%.1f", BIC),
PseudoR2 = ifelse(is.na(PseudoR2), "", sprintf("%.3f", PseudoR2))
) %>%
select(model, N, BIC, PseudoR2)
# ──────────────────────────────────────────────────────────────────────────────
# 5.  Inspect & save GOF table
# ──────────────────────────────────────────────────────────────────────────────
print(model_stats)
write.csv(model_stats, "final_model_gof_stats.csv", row.names = FALSE)
# (Optional: pretty display in RMarkdown)
if (requireNamespace("knitr", quietly = TRUE)) {
knitr::kable(
model_stats,
col.names = c("Model", "N", "BIC", "Pseudo R²"),
caption  = "Goodness-of-Fit Statistics"
)
}
# ──────────────────────────────────────────────────────────────────────────────
# 6.  (Optional) save coef table as well
# ──────────────────────────────────────────────────────────────────────────────
write.csv(coef_table, "final_model_coefficients.csv", row.names = FALSE)
